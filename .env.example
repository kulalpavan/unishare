# Local development
PORT=3000

# Live P2P transfers: ICE servers for WebRTC, as a JSON array.
# Default (no setting needed): Google's free public STUN server plus the
# Open Relay Project's free shared TURN servers on every transport — UDP,
# TCP on ports 80/443, and TLS (TURNS) on 443 — so browsers behind
# symmetric NATs (common on mobile networks) and networks that block UDP
# can still connect directly.
# The Open Relay credentials in the default are the project's published
# shared demo credentials; get your own free ones for heavy use:
# https://www.metered.ca/tools/openrelay/
# Override with your own list, e.g.:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:openrelay.metered.ca:80","username":"openrelayproject","credential":"openrelayproject"}]

# Abuse limits (defaults in parentheses; override for tests or busy servers):
# LIVE_MAX_ROOMS=1000
# LIVE_MAX_LISTING_BYTES=33554432
# LIVE_RATE_LIMIT=120
# LIVE_RATE_WINDOW_MS=10000
