# Local development (docker compose defaults)
DATABASE_URL=postgres://unishare:unishare@127.0.0.1:5433/unishare
TEST_DATABASE_URL=postgres://unishare:unishare@127.0.0.1:5433/unishare_test
STORAGE_DRIVER=local
UNISHARE_DATA_DIR=./data
PORT=3000
MAX_FILE_MB=200
MAX_REQUEST_MB=500
# PGSSL=true

# Render-only free deployment (no external storage account)
# DATABASE_URL=<Render internal connection string>
# STORAGE_DRIVER=pg
# UNISHARE_DATA_DIR=/tmp/unishare
# UNISHARE_SECRET=change-me
# MAX_FILE_MB=50
# MAX_REQUEST_MB=100

# Production (Render + Cloudflare R2)
# NODE_ENV=production
# STORAGE_DRIVER=r2
# UNISHARE_DATA_DIR=/tmp/unishare
# UNISHARE_SECRET=change-me
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=unishare
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_FORCE_PATH_STYLE=false
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Optional limits
# UPLOAD_RATE_LIMIT=30
# UNLOCK_RATE_LIMIT=10
# PG_POOL_MAX=5

# Live P2P transfers (hybrid mode): ICE servers for WebRTC, as a JSON array.
# Defaults to Google's free public STUN server. For symmetric-NAT fallback add
# a free TURN entry, e.g. from the Open Relay Project (https://www.metered.ca/tools/openrelay/):
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:openrelay.metered.ca:80","username":"openrelayproject","credential":"openrelayproject"}]
