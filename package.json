{
  "name": "unishare",
  "version": "2.0.0",
  "description": "UniShare - share files, folders and text via a single link, 100% peer-to-peer",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "verify:live": "node test/live-verify.js",
    "verify:chunk": "node test/chunk-verify.js",
    "verify": "npm run verify:live && npm run verify:chunk"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "ws": "^8.20.0"
  }
}
